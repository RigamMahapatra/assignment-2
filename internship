#include <iostream>
using namespace std;

int main() {
    int n;

    cout << "Enter array size: ";
    cin >> n;

    if (n <= 0) {
        cout << "Invalid array size";
        return 0;
    }

    int arr[n];

    cout << "Enter array elements: ";

    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    int largest = arr[0];

    for (int i = 1; i < n; i++) {
        if (arr[i] > largest) {
            largest = arr[i];
        }
    }

    cout << "Largest element = " << largest;

    return 0;
}
#include <iostream>
using namespace std;

int main() {
    int n;
    int positive = 0, negative = 0, zero = 0;

    cout << "Enter array size: ";
    cin >> n;

    if (n <= 0) {
        cout << "Invalid array size";
        return 0;
    }

    int arr[n];

    cout << "Enter array elements: ";

    for (int i = 0; i < n; i++) {
        cin >> arr[i];

        if (arr[i] > 0) {
            positive++;
        }
        else if (arr[i] < 0) {
            negative++;
        }
        else {
            zero++;
        }
    }

    cout << "Positive numbers: " << positive << endl;
    cout << "Negative numbers: " << negative << endl;
    cout << "Zeros: " << zero << endl;

    return 0;
}


#include <iostream>
#include <vector>
using namespace std;

// Function to calculate total marks
int calculateTotal(const vector<int>& marks) {
    int total = 0;

    for (int mark : marks) {
        total += mark;
    }

    return total;
}

// Function to calculate average marks
double calculateAverage(const vector<int>& marks) {
    if (marks.empty()) {
        return 0.0;
    }

    return static_cast<double>(calculateTotal(marks))
           / marks.size();
}

int main() {
    int n;

    cout << "Enter number of subjects: ";
    cin >> n;

    if (n <= 0) {
        cout << "Invalid number of subjects.";
        return 0;
    }

    vector<int> marks(n);

    for (int i = 0; i < n; i++) {
        cout << "Enter marks for subject " << i + 1 << ": ";
        cin >> marks[i];

        if (marks[i] < 0 || marks[i] > 100) {
            cout << "Marks must be between 0 and 100.";
            return 0;
        }
    }

    int total = calculateTotal(marks);
    double average = calculateAverage(marks);

    cout << "\nTotal Marks = " << total << endl;
    cout << "Average Marks = " << average << endl;

    return 0;
}
